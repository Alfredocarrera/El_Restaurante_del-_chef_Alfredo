    {
      "parameters": {
        "jsCode": "const callbackQuery = $input.item.json.callback_query;\nconst callbackData = callbackQuery.data;\nconst parts = callbackData.split('_');\n\nconst estadoMap = {\n  'preparacion': 'En Preparación',\n  'encamino': 'En Camino',\n  'entregado': 'Entregado'\n};\n\nreturn {\n  json: {\n    nuevo_estado: estadoMap[parts[1]] || 'Actualizado',\n    id_pedido: parts[2],\n    cliente_chat_id: parts[3] || callbackQuery.message.chat.id\n  }\n};"
