      "id": "360dbeba-8665-47f2-9564-8b39fb43f52b",
      "name": "Google Sheets: Get All Orders",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        224,
        656
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "MP4vqye5gOn1rClM",
          "name": "Google Sheets account"
        }
