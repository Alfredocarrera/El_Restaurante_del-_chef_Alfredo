    {
      "parameters": {
        "jsCode": "const orders = $items(\"Google Sheets: Get All Orders\").map(item => item.json);\nconst today = new Date().toISOString().split('T')[0];\nconst todayOrders = orders.filter(o => o.fecha === today);\n\nif (todayOrders.length === 0) {\n  return {\n    json: {\n      report_markdown: `📊 *REPORTE DIARIO DE VENTAS (${today})*\\n\\nNo se registraron pedidos hoy.`\n    }\n  };\n}\n\nlet totalRevenue = 0;\nconst productCounts = {};\nconst hourCounts = Array(24).fill(0);\n\ntodayOrders.forEach(order => {\n  totalRevenue += parseFloat(order.total_pago || 0);\n  const items = (order.detalles_pedido || \"\").split(', ');\n  items.forEach(itemStr => {\n    const parts = itemStr.match(/^(\\d+)x\\s+(.+)\\s+\\(Q/);\n    if (parts) {\n      const qty = parseInt(parts[1]);\n      const name = parts[2];\n      productCounts[name] = (productCounts[name] || 0) + qty;\n    }\n  });\n\n  if (order.hora) {\n    const hour = parseInt(order.hora.split(':')[0]);\n    if (!isNaN(hour)) {\n      hourCounts[hour]++;\n    }\n  }\n});\n\nlet topProduct = \"N/A\";\nlet maxQty = 0;\nfor (const [prod, qty] of Object.entries(productCounts)) {\n  if (qty > maxQty) {\n    maxQty = qty;\n    topProduct = `${prod} (${qty} unidades)`;\n  }\n}\n\nlet peakHour = \"N/A\";\nlet maxOrdersInHour = 0;\nhourCounts.forEach((count, hour) => {\n  if (count > maxOrdersInHour) {\n    maxOrdersInHour = count;\n    const formatHour = hour.toString().padStart(2, '0');\n    peakHour = `${formatHour}:00 - ${formatHour}:59 (${count} pedidos)`;\n  }\n});\n\nconst reportMarkdown = `\n📊 *REPORTE DIARIO DE VENTAS - RESTAURANTE CHEF ALFREDO*\n📅 *Fecha:* ${today}\n💰 *Total Vendido:* Q${totalRevenue.toFixed(2)}\n📦 *Total Pedidos:* ${todayOrders.length}\n⭐ *Producto Estrella:* ${topProduct}\n🔥 *Hora Pico:* ${peakHour}\n`;\n\nreturn {\n  json: {\n    report_markdown: reportMarkdown\n  }\n};"
      },
