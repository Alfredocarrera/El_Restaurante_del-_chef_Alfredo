    {
      "parameters": {
        "jsCode": "// Leemos los productos que vinieron de Google Sheets\nconst items = $items().map(item => item.json);\n\n// Si la hoja está vacía\nif (items.length === 0) {\n  return [{\n    json: {\n      texto_menu: \"📋 Por el momento no tenemos productos disponibles en el menú.\"\n    }\n  }];\n}\n\n// Agrupamos los productos por categoría\nconst categorias = {};\nitems.forEach(prod => {\n  const cat = prod.categoria || \"General\";\n  if (!categorias[cat]) categorias[cat] = [];\n  categorias[cat].push(prod);\n});\n\n// Construimos el texto del menú\nlet mensaje = \"📋 *MENÚ DEL RESTAURANTE CHEF ALFREDO*\\n\\n\";\n\nfor (const [cat, productos] of Object.entries(categorias)) {\n  mensaje += `*--- ${cat.toUpperCase()} ---*\\n`;\n  productos.forEach(p => {\n    const disponiblidad = parseInt(p.stock) > 0 ? `Q${parseFloat(p.precio).toFixed(2)}` : \"❌ Agotado\";\n    mensaje += `• *${p.nombre}* - ${disponiblidad}\\n  _${p.descripcion || ''}_\\n`;\n  });\n  mensaje += \"\\n\";\n}\n\nmensaje += \"💡 *¿Qué te gustaría pedir hoy?* Escríbeme el nombre del producto y la cantidad.\";\n\nreturn [{\n  json: {\n    texto_menu: mensaje\n  }\n}];"
      },
